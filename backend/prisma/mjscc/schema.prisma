// The MJSCC instructor evaluation: the evaluating instructors, their scores and the evaluation's one
// random draw. It shares the database server with the CSA Portal but nothing else: everything lives
// in its own "mjscc" schema, created and owned by its own database user ("mjscc", see
// supabase/mjscc-setup.sql), which can't reach the portal's schema, nor the portal's user this one.
// Row-level security is on for every table as well (see the init migration).
//
// The evaluation's content (students, questions, drill, commands) is in src/mjscc/content.ts; the
// tables refer to students, questions, movements and commands by their number there, from 1.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/mjscc"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mjscc"]
}

enum Part {
  THEORY
  DRILL
  COMMANDING
  INSPECTION

  @@schema("mjscc")
}

// An evaluating instructor. There are no accounts: they sign in with their name and the day's code,
// and the same name (however it's capitalised or spaced) is the same instructor, on any phone.
model Instructor {
  id         String    @id @default(uuid()) @db.Uuid
  // as they first typed it
  name       String
  // the name lowercased with its spaces tidied, which sign-in matches on
  nameKey    String    @unique @map("name_key")
  // set when they press Finish (only with every item scored), cleared if they reopen
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  sessions Session[]
  scores   Score[]
  notes    InspectionNote[]

  @@map("instructors")
  @@schema("mjscc")
}

// A signed-in phone. Like the portal's sessions, the phone holds a random token in an http-only
// cookie and only its SHA-256 hash is kept here.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  tokenHash    String   @unique @map("token_hash")
  instructorId String   @map("instructor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@map("sessions")
  @@schema("mjscc")
}

// One instructor's score for one student on one item: a theory question (1–40, scored 0–3), a drill
// movement (1–27, 0–5), one of the student's three commands (1–3, 0–5) or the inspection (item 1, 0–5).
model Score {
  instructorId String   @map("instructor_id") @db.Uuid
  student      Int
  part         Part
  item         Int
  value        Int
  updatedAt    DateTime @updatedAt @map("updated_at")

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([instructorId, student, part, item])
  @@map("scores")
  @@schema("mjscc")
}

// What an instructor wrote down about a student's inspection, if anything was wrong.
model InspectionNote {
  instructorId String   @map("instructor_id") @db.Uuid
  student      Int
  text         String
  updatedAt    DateTime @updatedAt @map("updated_at")

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([instructorId, student])
  @@map("inspection_notes")
  @@schema("mjscc")
}

// Each student's three commands, drawn at random the first time anyone opens the evaluation, so every
// instructor gets the same three. `command` is its number in the command list.
model CommandDraw {
  student  Int
  position Int
  command  Int

  @@id([student, position])
  @@map("command_draws")
  @@schema("mjscc")
}

// Sign-in attempts per key (e.g. "sign-in:<ip>") per time window, shared by every server instance.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limits")
  @@schema("mjscc")
}

// What transcripts are drawn with that mustn't be in the repository, which is public: the platoon's
// crest and stamp, the Platoon In-Charge's signature, the fonts, and (in details.json) everyone's full
// name. Loaded from a folder outside git by scripts/mjscc-transcripts.ts, and kept by a reset.
model TranscriptFile {
  // e.g. "stamp.png" (see src/mjscc/transcript-details.ts)
  name      String   @id
  type      String
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("transcript_files")
  @@schema("mjscc")
}
