# Copy to .env.local for local development; on Vercel, set these in the project's settings.
# Both are public (they reach the browser), so neither is a secret.

# The API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.agee.pro
# The site key of the "Invisible" Cloudflare Turnstile widget for portal.agee.pro
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The main site, for links from the portal (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.agee.pro
