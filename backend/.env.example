# Copy this file to .env and fill it in. .env is never committed.

# --- Database (Supabase) -------------------------------------------------------------------------
# From Supabase → Connect → ORMs → Prisma, with the user set to the "prisma" role from
# supabase/setup.sql and its password.
# The transaction pooler (port 6543), used by the running app:
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# The session pooler (port 5432), used for migrations:
DIRECT_URL="postgresql://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# --- The portal ----------------------------------------------------------------------------------
# The only site allowed to call this API (no trailing slash).
PORTAL_ORIGIN="https://portal.agee.pro"

# --- Bot check (Cloudflare Turnstile) -----------------------------------------------------------
# The secret key of an "Invisible" Turnstile widget for portal.agee.pro. Cloudflare's test key
# 1x0000000000000000000000000000000AA always passes; use it only for local development.
TURNSTILE_SECRET_KEY=""

# --- Signing secret -------------------------------------------------------------------------------
# At least 32 random characters, e.g. from: openssl rand -base64 48
HUMAN_SECRET=""

# --- Password key ---------------------------------------------------------------------------------
# Encrypts the copy of each password that User Management can show. 32 random bytes, from:
#   openssl rand -base64 32
# Keep it only here and in Vercel's settings. Anyone with it and a copy of the database can read
# every password; if it's ever lost, the stored passwords can't be shown (logins still work) until
# they're set again.
PASSWORD_KEY=""

# Local port (Vercel sets its own)
PORT=3300
