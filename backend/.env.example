# Copy this file to .env and fill it in. .env is never committed.

# --- Database (Supabase) -------------------------------------------------------------------------
# From Supabase → Connect → ORMs → Prisma, with the user set to the "prisma" role from
# supabase/setup.sql and its password.
# The transaction pooler (port 6543), used by the running app:
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# The session pooler (port 5432), used for migrations:
DIRECT_URL="postgresql://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# --- The portal ----------------------------------------------------------------------------------
# The only site allowed to call this API (no trailing slash).
PORTAL_ORIGIN="https://portal.agee.pro"

# --- Cookie secret -------------------------------------------------------------------------------
# Signs the cookies the API hands out besides the session. At least 32 random characters, e.g. from:
#   openssl rand -base64 48
COOKIE_SECRET=""

# --- Password key ---------------------------------------------------------------------------------
# Encrypts the copy of each password that User Management can show. 32 random bytes, from:
#   openssl rand -base64 32
# Keep it only here and in Vercel's settings. Anyone with it and a copy of the database can read
# every password; if it's ever lost, the stored passwords can't be shown (logins still work) until
# they're set again.
PASSWORD_KEY=""

# Local port (Vercel sets its own)
PORT=3300

# --- The MJSCC instructor evaluation (optional) --------------------------------------------------
# Leave MJSCC_DATABASE_URL out and the evaluation's routes (/mjscc) aren't served at all. Its tables
# live in their own "mjscc" schema, reached as their own database user from supabase/mjscc-setup.sql
# (never the "prisma" user above). From Supabase → Connect → ORMs → Prisma, with that user:
MJSCC_DATABASE_URL="postgresql://mjscc.[PROJECT-REF]:[MJSCC-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=mjscc"
MJSCC_DIRECT_URL="postgresql://mjscc.[PROJECT-REF]:[MJSCC-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?schema=mjscc"
# The only site allowed to call the evaluation's routes (no trailing slash).
MJSCC_ORIGIN="https://mjscc.agee.pro"
# The code instructors type with their name, given out on the day (at least 6 characters; capitals
# and surrounding spaces don't matter).
MJSCC_ACCESS_CODE=""
# The instructors who may sign in, comma-separated, as their names should show. Typing ignores
# capitals, spaces and apostrophes. The results come out once everyone on the list who has started
# scoring has finished (at least two), so someone who doesn't come doesn't hold them up.
MJSCC_INSTRUCTORS="Mish'al, Ibrysam, Malsa, Haneen"
